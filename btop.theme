# Red Monarch (Rose Black)

# Main background, leave empty for transparency
theme[main_bg]=""

# Main text color
theme[main_fg]="#FFEAF2"

# Title color for boxes
theme[title]="#F1396D"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#F1396D"

# Background color of selected item in processes box
theme[selected_bg]="#F1396D"

# Foreground color of selected item in processes box
theme[selected_fg]="#191414"

# Color of inactive/disabled text
theme[inactive_fg]="#6F555F"

# Misc colors for processes box including mini cpu graphs
theme[proc_misc]="#FF7AA3"

# Box outline and divider line color
theme[cpu_box]="#3A1F29"
theme[mem_box]="#3A1F29"
theme[net_box]="#3A1F29"
theme[proc_box]="#3A1F29"
theme[div_line]="#6F555F"

# Gradients for all meters and graphs
theme[temp_start]="#FFB3CA"
theme[temp_mid]="#F1396D"
theme[temp_end]="#FF4D80"

theme[cpu_start]="#F1396D"
theme[cpu_mid]="#FF6F9B"
theme[cpu_end]="#FFEAF2"

theme[mem_start]="#D93665"
theme[mem_mid]="#F1396D"
theme[mem_end]="#FFB3CA"

theme[net_start]="#FFEAF2"
theme[net_mid]="#FF7AA3"
theme[net_end]="#F1396D"

theme[proc_start]="#F1396D"
theme[proc_mid]="#FF5F91"
theme[proc_end]="#FFEAF2"

# Bottom bar
theme[btm_bg]=""
theme[btm_fg]="#FFEAF2"

# Explicit overrides
theme[power]       = "#F1396D"
theme[cpu_power]   = "#F1396D"
theme[watts]       = "#F1396D"
theme[freq]        = "#FF7AA3"
theme[cpu_freq]    = "#FF7AA3"
theme[ghz]         = "#FF7AA3"
theme[temp]        = "#FFEAF2"
theme[temp_crit]   = "#FF4D80"
theme[gpu_power]   = "#F1396D"
theme[gpu_freq]    = "#FF7AA3"
theme[gpu_temp]    = "#FF4D80"
theme[cpu_text]    = "#FFEAF2"

# End Red Monarch Theme
